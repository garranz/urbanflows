# Load the stl file

DEFINE basenm=kuala_lumpur_r1200
SURF STL ../scripts_stl/$(basenm)_flow_volume_v4.stl

MOVE_TO_ZONE NAME buildings SUBZONES 0
SPLIT BY_ANGLE 150 SUBZONES 0

MOVE_TO_ZONE NAME side SUBZONES 1
MOVE_TO_ZONE NAME ground SUBZONES 0

SPLIT BY_PLANE 244.584 278.595 269 0 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 0 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 -1 1 0 ZONES side


MOVE_TO_ZONE NAME s5 SUBZONES 448
MOVE_TO_ZONE NAME s6 SUBZONES 447
MOVE_TO_ZONE NAME s7 SUBZONES 446
MOVE_TO_ZONE NAME s0 SUBZONES 445
MOVE_TO_ZONE NAME s4 SUBZONES 444
MOVE_TO_ZONE NAME s3 SUBZONES 443
MOVE_TO_ZONE NAME s2 SUBZONES 442
MOVE_TO_ZONE NAME s1 SUBZONES 441

MOVE_TO_ZONE NAME top SUBZONES 106

#RUN_DIAGNOSTICS WITH_DETAILS WITH_SUBZONE_INFO CHECK_SELF_INTERSECTIONS WITH_NMT_COORDS
RUN_DIAGNOSTICS WITH_DETAILS CHECK_SELF_INTERSECTIONS 
WRITE_SBIN $(basenm).sbin
# Run to check for errors

INTERACTIVE

