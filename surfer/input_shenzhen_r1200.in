# Load the stl file

DEFINE basenm=shenzhen_r1200_dummy
SURF STL ../scripts_stl/$(basenm)_flow_volume.stl
#SURF STL ../urban-flight-master-CFD-OSM2STL/CFD/OSM2STL/flow_volume.stl
MOVE_TO_ZONE NAME buildings SUBZONES 0
SPLIT BY_ANGLE 150 SUBZONES 0


MOVE_TO_ZONE  NAME side SUBZONES 1
SPLIT BY_PLANE 244.584 278.595 269 0 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 0 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 -1 1 0 ZONES side


MOVE_TO_ZONE NAME s5 SUBZONES 360
MOVE_TO_ZONE NAME s6 SUBZONES 359
MOVE_TO_ZONE NAME s7 SUBZONES 358
MOVE_TO_ZONE NAME s0 SUBZONES 357
MOVE_TO_ZONE NAME s4 SUBZONES 356
MOVE_TO_ZONE NAME s3 SUBZONES 355
MOVE_TO_ZONE NAME s2 SUBZONES 354
MOVE_TO_ZONE NAME s1 SUBZONES 353

MOVE_TO_ZONE NAME top SUBZONES 128
MOVE_TO_ZONE NAME ground SUBZONES 0



# Run to check for errors
WRITE_SBIN $(basenm).sbin
RUN_DIAGNOSTICS WITH_DETAILS WITH_SUBZONE_INFO CHECK_SELF_INTERSECTIONS 

