# Load the stl file

DEFINE basenm=athens_r1200
SURF STL ../scripts_stl/$(basenm)_flow_volume_v2.stl
#SURF STL ../scripts_stl/athens_r1200_flow_volume.stl.work_2

MOVE_TO_ZONE NAME buildings SUBZONES 0
SPLIT BY_ANGLE 150 SUBZONES 0

MOVE_TO_ZONE NAME side SUBZONES 1
MOVE_TO_ZONE NAME ground SUBZONES 0
MOVE_TO_ZONE NAME top SUBZONES 728

SPLIT BY_PLANE 244.584 278.595 269 0 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 0 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 1 1 0 ZONES side
SPLIT BY_PLANE 244.584 278.595 269 -1 1 0 ZONES side

##
MOVE_TO_ZONE NAME s5 SUBZONES 2026
MOVE_TO_ZONE NAME s6 SUBZONES 2025
MOVE_TO_ZONE NAME s7 SUBZONES 2024
MOVE_TO_ZONE NAME s0 SUBZONES 2023
MOVE_TO_ZONE NAME s4 SUBZONES 2022
MOVE_TO_ZONE NAME s3 SUBZONES 2021
MOVE_TO_ZONE NAME s2 SUBZONES 2020
MOVE_TO_ZONE NAME s1 SUBZONES 2019

RUN_DIAGNOSTICS WITH_DETAILS WITH_SUBZONE_INFO CHECK_SELF_INTERSECTIONS 
WRITE_SBIN $(basenm).sbin
# Run to check for errors


