# Load the stl file

DEFINE basenm=shenzhen_x2200_y1600_dummy
SURF STL ../scripts_stl/$(basenm)_flow_volume.stl
#SURF STL ../urban-flight-master-CFD-OSM2STL/CFD/OSM2STL/flow_volume.stl
MOVE_TO_ZONE NAME buildings SUBZONES 0
SPLIT BY_ANGLE 150 SUBZONES 0



MOVE_TO_ZONE NAME x1 SUBZONES 351
MOVE_TO_ZONE NAME z1 SUBZONES 350
MOVE_TO_ZONE NAME top SUBZONES 349
MOVE_TO_ZONE NAME x0 SUBZONES 183
MOVE_TO_ZONE NAME z0 SUBZONES 1
MOVE_TO_ZONE NAME ground SUBZONES 0

#MOVE_TO_ZONE NAME x1 SUBZONES 353
#MOVE_TO_ZONE NAME z1 SUBZONES 349
#MOVE_TO_ZONE NAME top SUBZONES 348
#MOVE_TO_ZONE NAME x0 SUBZONES 181
#MOVE_TO_ZONE NAME z0 SUBZONES 24
#MOVE_TO_ZONE NAME ground SUBZONES 0


# Run to check for errors
RUN_DIAGNOSTICS WITH_DETAILS WITH_SUBZONE_INFO CHECK_SELF_INTERSECTIONS 
WRITE_SBIN $(basenm).sbin
INTERACTIVE
