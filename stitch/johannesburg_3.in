# Load the sbin generated by surfer
DEFINE name=johannesburg_r1200
PART SURF SBIN ../surfer/$(name).sbin

HCP_DELTA 60

HCP_WINDOW FAZONE GROUND LEVEL 6 NLAYERS 5,10,10,3,3
HCP_WINDOW FAZONE BUILDINGS LEVEL 6 NLAYERS 5,10,10,5,3,3
# Each level is Dx/2 

COUNT_POINTS    # forst stats
NSMOOTH 50      # smooth the initial point seeding 

WRITE_MLES $(name)_3.mles # save the resulting mesh

# Save a picutre of the mesh
WRITE_IMAGE NAME=images/$(name)_z GEOM=PLANE 1000 1000 10 0 0 1 VAR=3d_mesh MESH_ON_SURFACE SIZE 4800 2400
WRITE_IMAGE NAME=images/$(name)_y GEOM=PLANE 1000 1000 10 0 1 0 VAR=3d_mesh MESH_ON_SURFACE SIZE 4800 2400
WRITE_IMAGE NAME=images/$(name)_x GEOM=PLANE 1000 1000 10 1 0 0 VAR=3d_mesh MESH_ON_SURFACE SIZE 4800 2400
WRITE_IMAGE NAME=images/$(name)_z1 GEOM=PLANE 1000 1000 10 0 0 1 VAR=mesh MESH_ON_SURFACE SIZE 4800 2400
WRITE_IMAGE NAME=images/$(name)_z2 GEOM=PLANE 1000 1000 200 0 0 1 VAR=mesh MESH_ON_SURFACE SIZE 4800 2400
WRITE_IMAGE NAME=images/$(name)_z3 GEOM=PLANE 1000 1000 300 0 0 1 VAR=mesh MESH_ON_SURFACE SIZE 4800 2400
